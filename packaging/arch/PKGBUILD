# Maintainer: ohSystemmm <ohSystemmm@gmail.com>
pkgname=melodex
pkgver="0.0.8"
pkgrel=1
pkgdesc="A terminal based Musicplayer designed to play locally stored music."
arch=("x86_64")
url="https://github.com/ohSystemmm/melodex"
license=("GPLv3")

depends=(
	"libvlc"
	"ffmpeg"
	"go"
)

optdepends=(
    "kitty: To use Melodex"
    "ttf-firacode-nerd: To correctly display Unicode Characters."
)

checkdepends=()
provides=("melodex")
conflicts=("melodex-git")
md5sums=("SKIP")
source=("https://github.com/ohSystemmm/melodex/releases/download/v${pkgver}/melodex-${pkgver}.tar.gz")


build() {
    cd "$srcdir/melodex-${pkgver}"
    make
}

package() {
    install -Dm755 "$srcdir/melodex-${pkgver}/melodex" "$pkgdir/usr/bin/melodex"
}